{
  "name": "clinix-qa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "report": "playwright show-report",
    "docs:catalog": "node scripts/catalog.mjs",
    "docs:check": "node scripts/catalog.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "zod": "^4.6.7"
  }
}
